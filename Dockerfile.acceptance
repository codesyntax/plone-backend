# syntax=docker/dockerfile:1
ARG PYTHON_VERSION=3.13
ARG PLONE_VERSION
FROM plone/server-builder:${PLONE_VERSION} AS builder

ARG PLONE_VERSION

# Install robotframework support
RUN /app/bin/pip install plone.app.robotframework>=2.0.0

FROM plone/server-prod-config:${PLONE_VERSION}

ARG PYTHON_VERSION
ARG PLONE_VERSION

LABEL maintainer="Plone Community <dev@plone.org>" \
      org.label-schema.name="server-acceptance" \
      org.label-schema.description="Plone $PLONE_VERSION backend acceptance image using Python $PYTHON_VERSION" \
      org.label-schema.vendor="Plone Foundation"


# Copy /app from builder
COPY --from=builder --chown=500:500 /app /app

# Bake the acceptance instance at build time: robot-server is the entrypoint, so
# it bypasses the runtime wrapper. Render from the acceptance-specific instance.yaml.
RUN <<EOT
    set -e
    cd /app/render
    ./venv/bin/python transform_from_environment.py \
        -i acceptance-instance.yaml -o acceptance-from-environment.yaml
    ./venv/bin/cookiecutter -f --no-input \
        --config-file acceptance-from-environment.yaml \
        cookiecutter-zope-instance.zip -o /app
    test -f /app/instance/etc/zope.conf
    test -f /app/instance/etc/zope.ini
    test -f /app/instance/etc/site.zcml
    test -f /app/instance/etc/cors.zcml
    rm -f acceptance-from-environment.yaml
    chown -R 500:500 /app/instance
EOT

# Set chameleon cache directory under /data (the obsolete /app/var symlink is gone)
ENV CHAMELEON_CACHE=/data/cache
# Zope listens to all ip addresses
ENV ZSERVER_HOST=0.0.0.0
# Zope port to be 55001
ENV ZSERVER_PORT=55001
# This fixes the healthcheck defined in server-prod-config
ENV LISTEN_PORT=${ZSERVER_PORT}
# Profiles to be added to the created site
ENV APPLY_PROFILES=plone.app.contenttypes:plone-content,plone.restapi:default,plone.volto:default
# Packages to be used in configuration
ENV CONFIGURE_PACKAGES=plone.app.contenttypes,plone.restapi,plone.volto,plone.volto.cors

# Also expose port 55001
EXPOSE 55001

# Entrypoint is robot-server
ENTRYPOINT [ "/app/bin/robot-server" ]

# Run VOLTO_ROBOT_TESTING by default
CMD ["plone.app.robotframework.testing.VOLTO_ROBOT_TESTING"]
